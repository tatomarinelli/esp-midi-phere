import Live
from _Framework.ControlSurface import ControlSurface
from _Framework.SubjectSlot import subject_slot
from _Framework.EncoderElement import EncoderElement
from _Framework.InputControlElement import MIDI_CC_TYPE

# CC (LED_CC_BASE + pot index) drives that pot's bar. Must match ledCcBase /
# midiChannel in esp-midi-phere.ino (CC20 = pot 1's bar, CC21 = pot 2's bar).
LED_CC_BASE = 20
# CC (POT_CC_BASE + pot index) is the pot's own raw position, sent by the ESP.
# Must match ccNumbers[] in esp-midi-phere.ino (CC1 = pot 1, CC2 = pot 2).
POT_CC_BASE = 1
MIDI_CHANNEL = 0  # raw MIDI status byte is 0-indexed; this is "channel 1" on the wire

# Name of each pot's Macro, as renamed in the Audio Effect Rack's UI.
# Index i is two-way bound: the pot's own CC (POT_CC_BASE + i) drives this
# Macro's value (input), and the Macro's value is forwarded to CC
# (LED_CC_BASE + i) to drive that pot's LED bar (output).
#
# Fixed binding, not tied to track selection: whichever track in the whole
# song has a Macro with this exact name gets bound, regardless of what's
# selected in Live's UI. This is the "your original goal" design from the
# README -- pot 1/2 always control the same target, not just whatever
# happens to be showing. (An earlier version of this script followed the
# *selected* track instead, which was simpler for quick testing but meant
# the pot did nothing and the LED went stale the moment you clicked a
# different track -- not the intended end behavior.)
# 3 sticks = 3 channels x 2 macros = 6 pots. Naming: POT<channel>-<macroIndex>.
POT_PARAMETER_NAMES = ['POT1-1', 'POT1-2', 'POT2-1', 'POT2-2', 'POT3-1', 'POT3-2']

# Periodic re-scan of the whole song, in Live's schedule_message "ticks"
# (undocumented real-time length, roughly a few seconds). This is the only
# rebind trigger now that binding doesn't depend on track selection -- it
# catches a macro being renamed to/from a POT_PARAMETER_NAMES entry, a
# device/track being deleted, or a new match appearing after a rack is
# built, none of which fire an event we could listen to directly.
RESCAN_INTERVAL_TICKS = 20


class ESP_MIDI_Phere(ControlSurface):
    __module__ = __name__
    __doc__ = "Two-way binds named Macros anywhere in the song to the esp-midi-phere controller: pot CC drives the Macro, and the Macro's value drives that pot's LED bar CC. Binding is fixed, independent of Live's track selection."

    def __init__(self, c_instance):
        super(ESP_MIDI_Phere, self).__init__(c_instance)
        with self.component_guard():
            self._pot_parameters = [None] * len(POT_PARAMETER_NAMES)
            # One subject_slot listener per pot -- each is a distinct method
            # (see _on_pot0_changed / _on_pot1_changed below) since subject_slot
            # is a class-level descriptor and can't be generated dynamically
            # in a loop.
            self._pot_listeners = [
                self._on_pot0_changed, self._on_pot1_changed, self._on_pot2_changed,
                self._on_pot3_changed, self._on_pot4_changed, self._on_pot5_changed,
            ]
            # One EncoderElement per pot, permanently bound to that pot's own
            # CC. connect_to()/release_parameter() is Live's standard
            # mechanism for binding a MIDI CC to a device parameter -- the
            # same thing Ctrl+M MIDI-Map mode does by hand -- done here
            # automatically whenever a Macro matching POT_PARAMETER_NAMES[i]
            # is found anywhere in the song.
            self._pot_encoders = [
                EncoderElement(MIDI_CC_TYPE, MIDI_CHANNEL, POT_CC_BASE + i, Live.MidiMap.MapMode.absolute)
                for i in range(len(POT_PARAMETER_NAMES))
            ]
            self._refresh_all(force=True)
            self._schedule_rescan()

    def _all_tracks(self):
        song = self.song()
        return tuple(song.tracks) + tuple(song.return_tracks) + (song.master_track,)

    def _find_parameter_anywhere(self, name):
        for track in self._all_tracks():
            for device in track.devices:
                for parameter in device.parameters:
                    if parameter.name == name:
                        return parameter
        return None

    # Live's API doesn't guarantee the same Python object back from repeated
    # device.parameters lookups, even for the exact same macro -- so comparing
    # "is this the same object as before" is unreliable and can spuriously
    # report a change every single rescan, resending MIDI forever even though
    # nothing changed. Checking a stable property (the name) instead of
    # identity avoids that.
    def _current_parameter_still_matches(self, index):
        parameter = self._pot_parameters[index]
        if parameter is None:
            return False
        try:
            return parameter.name == POT_PARAMETER_NAMES[index]
        except RuntimeError:
            return False  # underlying Live object was deleted

    def _schedule_rescan(self):
        self.schedule_message(RESCAN_INTERVAL_TICKS, self._periodic_rescan)

    def _periodic_rescan(self):
        self._refresh_all(force=False)
        self._schedule_rescan()

    def _refresh_all(self, force):
        for index in range(len(POT_PARAMETER_NAMES)):
            self._refresh_parameter(index, force)

    # force=True: always re-search and re-bind (both directions), used once
    # at startup so the initial state is pushed even though nothing has
    # "changed" yet.
    # force=False (periodic rescan): only re-search/rebind if the parameter
    # we already have is no longer valid or no longer named correctly --
    # avoids redundant MIDI resends every rescan when nothing changed.
    def _refresh_parameter(self, index, force):
        if not force and self._current_parameter_still_matches(index):
            return

        name = POT_PARAMETER_NAMES[index]
        found = self._find_parameter_anywhere(name)

        # connect_to(None) releases any existing binding on its own, so this
        # covers both "rebind to a new match" and "nothing found, unbind".
        self._pot_encoders[index].connect_to(found)

        self._pot_parameters[index] = found
        listener = self._pot_listeners[index]
        if found is None:
            listener.subject = None
        else:
            listener.subject = found
            listener()

    def _send_pot_cc(self, index):
        parameter = self._pot_parameters[index]
        value_range = parameter.max - parameter.min
        normalized = 0.0
        if value_range > 0:
            normalized = (parameter.value - parameter.min) / value_range
        normalized = max(0.0, min(1.0, normalized))
        midi_value = int(round(normalized * 127))
        status = 0xB0 | MIDI_CHANNEL
        self._send_midi((status, LED_CC_BASE + index, midi_value))

    @subject_slot('value')
    def _on_pot0_changed(self):
        self._send_pot_cc(0)

    @subject_slot('value')
    def _on_pot1_changed(self):
        self._send_pot_cc(1)

    @subject_slot('value')
    def _on_pot2_changed(self):
        self._send_pot_cc(2)

    @subject_slot('value')
    def _on_pot3_changed(self):
        self._send_pot_cc(3)

    @subject_slot('value')
    def _on_pot4_changed(self):
        self._send_pot_cc(4)

    @subject_slot('value')
    def _on_pot5_changed(self):
        self._send_pot_cc(5)

    def disconnect(self):
        for encoder in self._pot_encoders:
            encoder.release_parameter()
        super(ESP_MIDI_Phere, self).disconnect()
